# ============================================================
# Portfolio Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to source control.
# ============================================================

# Formspree Endpoint
# 1. Go to https://formspree.io and create a free account.
# 2. Create a new form pointing to your email address.
# 3. Copy the endpoint URL (looks like: https://formspree.io/f/xxxxxxxx)
# 4. Paste the full URL below.
#
# Example:
#   VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
#
VITE_FORMSPREE_ENDPOINT=
